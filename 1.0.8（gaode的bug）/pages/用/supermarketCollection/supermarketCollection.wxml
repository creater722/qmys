<navigation-bar title="我的收藏" color="black" background="#FFF"></navigation-bar>
<view class="hero hero-collection">
  <view class="hero-title">我的收藏</view>
  <view class="hero-subtitle">查看已收藏的超市</view>
</view>

<!-- 加载状态 -->
<view wx:if="{{isLoading}}" class="loading-container">
  <view class="loading-spinner"></view>
  <view class="loading-text">正在加载收藏的超市...</view>
</view>

<!-- 收藏列表 -->
<scroll-view wx:else class="scrollarea" scroll-y type="list">
  <view class="content">
    <view class="section">
      <view class="section-title">收藏的超市</view>
      <view class="supermarket-list">
        <!-- 收藏列表 -->
        <block wx:if="{{collectionList.length === 0}}">
          <view class="empty-state">
            <text class="empty-icon">❤️</text>
            <text class="empty-text">还没有收藏的超市</text>
          </view>
        </block>
        <block wx:else>
          <view class="supermarket-item" wx:for="{{collectionList}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
            <image class="supermarket-image" src="{{item.image}}" mode="aspectFill" binderror="imageError" data-index="{{index}}"></image>
            <view class="supermarket-info">
              <view class="supermarket-name">{{item.name}}</view>
              <view class="supermarket-address">{{item.address}}</view>
              <view class="supermarket-distance">{{item.distance}} 米</view>
            </view>
            <view class="supermarket-action">
              <button class="uncollect-button" bindtap="removeCollection" data-id="{{item.id}}">
                <text class="uncollect-icon">💔</text>
              </button>
            </view>
          </view>
        </block>
      </view>
    </view>
  </view>
</scroll-view>

<!-- 底部按钮 -->
<view class="bottom-button-container">
  <button class="bottom-button" bindtap="goToSupermarketList">
    <text class="bottom-button-icon">🛒</text>
    <text class="bottom-button-text">去添加收藏</text>
  </button>
</view>