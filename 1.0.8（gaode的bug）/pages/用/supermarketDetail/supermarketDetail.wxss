.scrollarea {
  height: calc(100vh - 80rpx);
}

.content {
  padding: 20rpx;
}

.supermarket-header {
  background: white;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 20rpx;
}

.supermarket-image {
  width: 100%;
  height: 400rpx;
}

.supermarket-basic-info {
  padding: 20rpx;
}

.supermarket-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.supermarket-address {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.supermarket-hours {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.supermarket-distance {
  font-size: 28rpx;
  color: #4CAF50;
  font-weight: 500;
}

.section {
  background: white;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item {
  display: flex;
  margin-bottom: 15rpx;
}

.info-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #666;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
}

.feature-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
}

.feature-icon {
  color: #4CAF50;
  margin-right: 8rpx;
  font-weight: bold;
}

.feature-text {
  color: #333;
}

.review-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.review-item {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.review-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.review-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.review-user {
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
}

.review-rating {
  font-size: 22rpx;
  color: #FF9800;
}

.review-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  margin-bottom: 10rpx;
}

.review-time {
  font-size: 20rpx;
  color: #999;
}

.action-bar {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
  margin-bottom: 20rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}

.map-btn {
  background: #2196F3;
  color: white;
}

.collect-btn {
  background: #f5f5f5;
  color: #333;
}

.btn-icon {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}