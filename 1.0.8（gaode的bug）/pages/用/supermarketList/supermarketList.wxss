.hero {
  padding: 20rpx;
  text-align: center;
  background: #f5f5f5;
  margin-bottom: 0;
}

.hero-supermarket {
  background: linear-gradient(135deg, #4CAF50, #45a049);
  color: white;
}

.hero-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.hero-subtitle {
  font-size: 32rpx;
  opacity: 0.9;
  margin-bottom: 10rpx;
}

/* 收藏夹按钮 */
.collection-button-container {
  display: flex;
  justify-content: center;
  padding: 20rpx;
  background: white;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.collection-button {
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  color: #4CAF50;
  border: 2rpx solid #4CAF50;
  border-radius: 24rpx;
  padding: 16rpx 40rpx;
  font-size: 32rpx;
  width: 80%;
  max-width: 400rpx;
}

.collection-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.collection-text {
  font-size: 32rpx;
  font-weight: 500;
}

.scrollarea {
  height: calc(100vh - 120rpx);
}

.content {
  padding: 20rpx;
}

.section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.supermarket-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.supermarket-item {
  display: flex;
  background: white;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.3s ease;
  align-items: center;
}

.supermarket-item:hover {
  transform: translateY(-2rpx);
}

.supermarket-image {
  width: 200rpx;
  height: 150rpx;
  flex-shrink: 0;
}

.supermarket-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.supermarket-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.supermarket-address {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.supermarket-hours {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.supermarket-meta {
  margin-top: 8rpx;
}

.supermarket-distance {
  font-size: 30rpx;
  color: #4CAF50;
  font-weight: 500;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: calc(100vh - 120rpx);
  padding: 20rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 8rpx solid #f3f3f3;
  border-top: 8rpx solid #4CAF50;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 32rpx;
  color: #666;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.refresh-button {
  padding: 16rpx 40rpx;
  background: #4CAF50;
  color: white;
  border: none;
  border-radius: 24rpx;
  font-size: 32rpx;
}

