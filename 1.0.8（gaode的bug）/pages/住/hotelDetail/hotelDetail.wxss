/* pages/住/hotelDetail/hotelDetail.wxss */
page {
  background-color: #f5f5f5;
  font-size: 28rpx;
  color: #333;
}

/* 返回按钮 */
.back-btn {
  position: fixed;
  top: 20rpx;
  left: 20rpx;
  z-index: 999;
  display: flex;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.8);
  padding: 15rpx 20rpx;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.back-icon {
  font-size: 32rpx;
  color: #007aff;
  margin-right: 8rpx;
}

.back-text {
  font-size: 28rpx;
  color: #007aff;
}

/* 页面容器 */
.page-container {
  padding-bottom: 120rpx; /* 给底部操作栏留空间 */
}

/* 酒店封面图 */
.cover-img {
  width: 100%;
  height: auto;
  min-height: 300rpx;
}

/* 基础信息 */
.base-info {
  background-color: #fff;
  padding: 30rpx 20rpx;
  margin-bottom: 20rpx;
}

.base-info .name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #1a1a1a;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.tag {
  padding: 8rpx 15rpx;
  background-color: #f0f8ff;
  color: #007aff;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.star-tag {
  background-color: #fff8e1;
  color: #ff9800;
}

.score-tag {
  background-color: #e8f5e9;
  color: #4caf50;
}

.address, .phone {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.address icon, .phone icon {
  margin-right: 10rpx;
}

.phone {
  color: #007aff;
  cursor: pointer;
}

/* 设施服务通用样式 */
.facility-wrap, .service-wrap {
  background-color: #fff;
  padding: 30rpx 20rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #1a1a1a;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #eee;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

/* 房型列表 */
.room-list {
  background-color: #fff;
  padding: 30rpx 20rpx;
  margin-bottom: 20rpx;
}

.room-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.room-item:last-child {
  border-bottom: none;
}

.room-info {
  flex: 1;
}

.room-type {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
  color: #1a1a1a;
}

.desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

.room-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.price {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff5722;
  margin-bottom: 15rpx;
}

.book-btn {
  background-color: #007aff;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 12rpx 30rpx;
  font-size: 26rpx;
}

/* ========== 新增：按钮禁用状态样式 ========== */
.book-btn[disabled],
.collect-btn[disabled],
.book-all-btn[disabled] {
  background-color: #cccccc !important;
  color: #999999 !important;
  border-color: #eeeeee !important;
  opacity: 0.8;
}

/* ========== 新增：空数据提示样式 ========== */
.empty-tip {
  color: #999;
  text-align: center;
  padding: 30rpx 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background-color: #fff;
  padding: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 99;
}

.collect-btn {
  flex: 1;
  background-color: #fff;
  color: #ff5722;
  border: 1rpx solid #ff5722;
  border-radius: 40rpx;
  margin-right: 20rpx;
  font-size: 28rpx;
}

.book-all-btn {
  flex: 2;
  background-color: #007aff;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  font-size: 28rpx;
}

/* 按钮点击态（保留原有，优化体验） */
.book-btn:active, 
.collect-btn:active, 
.book-all-btn:active {
  opacity: 0.8;
}

/* ========== 新增：hover 状态样式（兼容 WXML 的 hover-class） ========== */
.book-btn-hover {
  background-color: #0066cc !important;
}

.collect-btn-hover {
  background-color: #f8f8f8 !important;
  color: #e64a19 !important;
}

.book-all-btn-hover {
  background-color: #0066cc !important;
}

/* 适配小屏手机 */
@media (max-width: 375px) {
  .base-info .name {
    font-size: 32rpx;
  }
  
  .price {
    font-size: 28rpx;
  }
  
  .book-btn {
    padding: 10rpx 20rpx;
    font-size: 24rpx;
  }

  /* 小屏适配空数据提示 */
  .empty-tip {
    padding: 20rpx 10rpx;
    font-size: 26rpx;
  }
}

/* ========== 新增：通用样式优化 ========== */
/* 防止按钮文字溢出 */
button {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 修复 iOS 下按钮点击高亮 */
button::after {
  border: none !important;
}