.page-container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  text-align: center;
}

.loading {
  text-align: center;
  font-size: 28rpx;
  color: #999;
  padding: 100rpx 0;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  color: #ccc;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.empty-btn {
  background-color: #1989fa;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  padding: 15rpx 40rpx;
  font-size: 28rpx;
}

.list {
  height: calc(100vh - 180rpx);
}

.house-item {
  background-color: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.item-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.item-price {
  font-size: 32rpx;
  color: #ff4d4f;
  margin-bottom: 15rpx;
}

.item-info {
  display: flex;
  gap: 20rpx;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.item-op {
  display: flex;
  justify-content: flex-end;
}

.uncollect-btn {
  background-color: #fff;
  color: #ff4d4f;
  border: 1px solid #ff4d4f;
  border-radius: 8rpx;
  padding: 10rpx 20rpx;
  font-size: 26rpx;
}

.back-btn {
  position: fixed;
  bottom: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 28rpx;
  color: #1989fa;
  padding: 15rpx 40rpx;
  background-color: #fff;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}