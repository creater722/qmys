/* 全局样式重置 */
page {
  background-color: #f8f8f8;
  font-size: 28rpx;
  color: #333;
}

/* 返回按钮样式 */
.back-btn {
  padding: 20rpx;
  display: flex;
  align-items: center;
  color: #333;
  font-size: 28rpx;
}

.back-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.back-text {
  font-size: 28rpx;
}

/* 页面容器 */
.page-container {
  padding: 0 20rpx;
  box-sizing: border-box;
}

/* 搜索栏样式 */
.search-bar {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 8rpx;
  padding: 10rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.search-input {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.search-input input {
  flex: 1;
  margin-left: 10rpx;
  font-size: 28rpx;
  color: #333;
}

.search-btn {
  background-color: #007aff;
  color: #fff;
  border-radius: 6rpx;
  padding: 10rpx 20rpx;
  font-size: 26rpx;
  margin-left: 10rpx;
}

/* 筛选栏滚动容器 */
.filter-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

/* 筛选栏样式 */
.filter-bar {
  display: inline-flex;
  align-items: center;
  background-color: #fff;
  border-radius: 8rpx;
  padding: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

/* 筛选项通用样式 */
.filter-item {
  padding: 10rpx 20rpx;
  margin: 0 10rpx;
  font-size: 26rpx;
  border-radius: 6rpx;
  position: relative;
  white-space: nowrap;
}

.filter-item.active {
  background-color: #007aff;
  color: #fff;
}

/* 城市筛选项特殊样式 */
.city-filter {
  display: flex;
  align-items: center;
}

.arrow-icon {
  font-size: 20rpx;
  margin-left: 8rpx;
}

/* 城市选择弹窗样式 */
.city-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
}

.modal-mask {
  width: 100%;
  height: 100%;
  background-color: rgba(0,0,0,0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  border-radius: 16rpx 16rpx 0 0;
  padding: 20rpx;
  max-height: 80vh;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #eee;
}

.city-list-scroll {
  height: 400rpx;
  margin-bottom: 20rpx;
}

.city-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
  font-size: 28rpx;
  color: #333;
}

.city-item:active {
  background-color: #f5f5f5;
}

.modal-close {
  width: 100%;
  background-color: #f5f5f5;
  color: #333;
  border-radius: 8rpx;
  padding: 15rpx 0;
  font-size: 28rpx;
}

/* 酒店列表样式 */
.hotel-list {
  margin-bottom: 100rpx; /* 给底部TabBar预留空间 */
}

.hotel-item {
  display: flex;
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

/* 酒店封面图 */
.cover-wrap {
  width: 200rpx;
  height: 150rpx;
  position: relative;
  margin-right: 20rpx;
}

.cover-img {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.price-tag {
  position: absolute;
  bottom: 0;
  left: 0;
  background-color: rgba(255, 59, 48, 0.9);
  color: #fff;
  padding: 5rpx 10rpx;
  font-size: 24rpx;
  border-radius: 0 8rpx 0 8rpx;
}

/* 酒店信息区域 */
.info-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.info-wrap .name {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  color: #333;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}

.tag {
  font-size: 22rpx;
  padding: 3rpx 8rpx;
  border-radius: 4rpx;
  margin-right: 10rpx;
  margin-bottom: 5rpx;
}

.star-tag {
  background-color: #fff8e1;
  color: #ffb74d;
  border: 1rpx solid #ffcc80;
}

.score-tag {
  background-color: #e1f5fe;
  color: #4fc3f7;
  border: 1rpx solid #81d4fa;
}

.address {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.facilities {
  display: flex;
  flex-wrap: wrap;
}

.facilities text {
  font-size: 22rpx;
  color: #999;
  margin-right: 10rpx;
}

/* 空状态/加载中/加载更多 */
.empty, .loading, .load-more {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #999;
}

.empty-img {
  width: 150rpx;
  height: 150rpx;
  margin-bottom: 20rpx;
}

.load-more button {
  background-color: #f5f5f5;
  color: #666;
  border-radius: 8rpx;
  padding: 10rpx 30rpx;
  font-size: 26rpx;
}

/* 底部伪TabBar样式 */
.custom-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  justify-content: space-around;
  align-items: center;
  border-top: 1rpx solid #eee;
  z-index: 999;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.03);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  color: #999;
  font-size: 24rpx;
}

.tab-item.active {
  color: #007aff;
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.tab-text {
  font-size: 22rpx;
  line-height: 1;
}