/* pages/住/hotel_user/orderConfirm/orderConfirm.wxss */
page {
  background-color: #f5f5f5;
  font-size: 28rpx;
  color: #333;
}

.page-container {
  padding: 20rpx;
  padding-bottom: 120rpx;
}

/* 返回按钮 */
.back-btn {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.back-icon {
  font-size: 32rpx;
  color: #007aff;
  margin-right: 8rpx;
}

.back-text {
  font-size: 28rpx;
  color: #007aff;
}

/* 通用标题 */
.title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #1a1a1a;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #eee;
}

/* 订单信息 */
.order-info {
  background-color: #fff;
  padding: 30rpx 20rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.label {
  color: #666;
}

.value {
  color: #333;
}

.price {
  color: #ff5722;
  font-weight: bold;
}

/* 入住信息 */
.checkin-info {
  background-color: #fff;
  padding: 30rpx 20rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.date-item, .guest-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.date-item:last-child, .guest-item:last-child {
  margin-bottom: 0;
}

.picker-value {
  color: #007aff;
  padding: 10rpx 20rpx;
  background-color: #f0f8ff;
  border-radius: 5rpx;
}

.guest-control {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.btn-minus, .btn-plus {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  background-color: #f0f8ff;
  color: #007aff;
  border-radius: 50%;
  font-size: 32rpx;
  padding: 0;
}

.guest-count {
  font-size: 32rpx;
  font-weight: bold;
}

/* 联系人信息 */
.contact-info {
  background-color: #fff;
  padding: 30rpx 20rpx;
  border-radius: 10rpx;
  margin-bottom: 40rpx;
}

.input-item {
  margin-bottom: 20rpx;
}

.input-item:last-child {
  margin-bottom: 0;
}

.input-item .label {
  display: block;
  margin-bottom: 10rpx;
  color: #666;
}

.input, .textarea {
  width: 100%;
  padding: 20rpx;
  background-color: #f9f9f9;
  border-radius: 5rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea {
  min-height: 120rpx;
  resize: none;
}

/* 提交按钮 */
.submit-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.submit-btn {
  width: 100%;
  background-color: #007aff;
  color: #fff;
  border: none;
  border-radius: 40rpx;
  padding: 25rpx 0;
  font-size: 32rpx;
}

.submit-btn:active {
  opacity: 0.8;
}