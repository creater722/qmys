/* 新增：返回栏样式 */
.header-bar {
  padding: 20rpx 30rpx;
  background-color: #fff;
}
.back-btn {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
}
.back-btn .iconfont {
  font-size: 24rpx;
  margin-right: 8rpx;
  color: #666;
}
.back-text {
  font-size: 28rpx;
}

/* 原有样式保持不变 */
.personal-center {
  min-height: 100vh;
  background-color: #f5f5f5;
}
.user-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background-color: #fff;
  margin-bottom: 20rpx;
}
.user-card.unlogin {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}
.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
}
.avatar image {
  width: 100%;
  height: 100%;
}
.info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.nickname {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.phone {
  font-size: 26rpx;
  color: #999;
}
.user-card.unlogin .phone {
  color: rgba(255,255,255,0.8);
}
.arrow {
  color: #ccc;
}
.menu-list {
  background-color: #fff;
}
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-left {
  display: flex;
  align-items: center;
}
.menu-left .iconfont {
  font-size: 36rpx;
  color: #409eff;
  margin-right: 20rpx;
}
.menu-title {
  font-size: 30rpx;
  color: #333;
}
.menu-right {
  display: flex;
  align-items: center;
  color: #ccc;
}
.badge {
  background-color: #f56c6c;
  color: #fff;
  font-size: 22rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  margin-right: 10rpx;
}
.logout-btn {
  margin: 60rpx 30rpx;
  padding: 24rpx;
  background-color: #fff;
  color: #f56c6c;
  text-align: center;
  border-radius: 8rpx;
  font-size: 30rpx;
}
.shop-entrance {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background: #fff;
  margin: 20rpx 0;
  border-radius: 8rpx;
  color: #ff6b35;
  font-size: 30rpx;
}
.shop-entrance .iconfont {
  margin-right: 15rpx;
  font-size: 32rpx;
}
.shop-entrance .arrow {
  color: #ccc;
}