.page{
  min-height:100vh;
  background:#f5f5f5;
  padding:32rpx;
}
.page.dark{
  background:#0d0d0d;
  color:#e5e5e5;
}

.skeleton{ padding:32rpx; }
.sk-card{
  display:flex;
  background:#fff;
  border-radius:20rpx;
  padding:32rpx;
  margin-bottom:28rpx;
}
.page.dark .sk-card{ background:#1a1a1a; }
.sk-cover{
  width:180rpx;
  height:180rpx;
  background:#e6e6e6;
  border-radius:12rpx;
}
.page.dark .sk-cover{ background:#2a22; }
.sk-info{ flex:1; margin-left:24rpx; }
.sk-line{
  height:32rpx;
  background:#e6e6e6;
  border-radius:8rpx;
  margin:20rpx 0 0 24rpx;
}
.page.dark .sk-line{ background:#2a2a2a; }

.empty{
  text-align:center;
  padding-top:40vh;
}
.empty text{
  font-size:36rpx;
  color:#888;
}

.card{
  display:flex;
  background:#fff;
  border-radius:20rpx;
  margin-bottom:28rpx;
  padding:32rpx;
}
.page.dark .card{ background:#1a1a1a; }

.cover{
  width:180rpx;
  height:180rpx;
  border-radius:12rpx;
  background:#ddd;
}
.meta{
  flex:1;
  margin-left:32rpx;
}
.title{
  font-size:38rpx;
  font-weight:500;
}
.sub{
  font-size:32rpx;
  color:#666;
  line-height:1.6;
}
.page.dark .sub{ color:#aaa; }

.bottom{
  display:flex;
  justify-content:space-between;
  margin-top:20rpx;
}
.date{
  font-size:28rpx;
  color:#999;
}

.heart{
  font-size:48rpx;
  color:#f44336;
}

.load-more{
  text-align:center;
  font-size:28rpx;
  padding:30rpx 0;
  color:#888;
}
navigation-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 999;
}
