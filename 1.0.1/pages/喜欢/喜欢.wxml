<view class="page {{theme}}">
  <navigation-bar title="我的喜欢" />

  <view wx:if="{{loading}}" class="skeleton">
    <block wx:for="{{8}}" wx:key="*">
      <view class="sk-card">
        <view class="sk-cover"></view>
        <view class="sk-line"></view>
        <view class="sk-line"></view>
      </view>
    </block>
  </view>

  <view wx:elif="{{likeList.length === 0}}" class="empty">
    <text>暂无喜欢内容</text>
  </view>

  <view class="list" wx:else>
    <scroll-view scroll-y>
      <view class="card" wx:for="{{likeList}}" wx:key="id">
        <view class="cover"></view>
        
        <view class="meta">
          <text class="title">{{item.title}}</text>
          <text class="desc">{{item.desc}}</text>
          <view class="bottom">
            <text class="date">{{item.date}}</text>
            <text class="heart" catchtap="deleteLike" data-id="{{item.id}}">♥</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="load-more">已经到底了</view>
</view>
